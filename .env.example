# Variables para desplegar con Docker Compose. Copia este archivo como .env y llena los valores.
# El archivo .env NO se sube al repositorio: contiene claves.

# Clave de la base de datos. Usa letras y números (sin punto y coma ni signo igual), porque
# va dentro de la cadena de conexión. Para generar una: openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave con la que se firman las sesiones. Mínimo 32 caracteres, aleatoria. Si alguien la conoce
# puede fabricarse una sesión de cualquier rol. Para generar una: openssl rand -base64 48
JWT_SECRET_KEY=

# Contraseña con la que se crean los usuarios iniciales (directora, administradores, maestros)
# la primera vez que arranca el sistema. Mínimo 8 caracteres, con mayúscula, minúscula, número
# y símbolo. Cámbiala desde cada cuenta después de entrar.
SEED_PASSWORD_INICIAL=

# Puerto en el que se publica la interfaz web (opcional; por omisión 8080).
# PUERTO_WEB=8080
