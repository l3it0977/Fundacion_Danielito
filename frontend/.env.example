# Copia este archivo como .env y ajusta los valores. Todo lo que empieza con VITE_ queda a la
# vista en el navegador: aquí no va ninguna clave secreta.

# Dirección de la API. Debe estar autorizada en Cors:OrigenesPermitidos del backend.
VITE_API_URL=http://localhost:5002

# Proveedor de mapas (opcional). Por omisión se usa OpenStreetMap.
# VITE_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILES_ATTRIBUTION=© OpenStreetMap
